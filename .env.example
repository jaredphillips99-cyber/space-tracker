# Anthropic API key — required for /api/analyze, /api/portfolio, /api/retirement
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (client bundle uses VITE_*; serverless falls back to these or VITE_*)
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# Optional server aliases (used by GitHub Actions + Claude-route JWT verify):
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Operator allowlist — comma-separated. Magic-link login does NOT grant admin.
# Rotate by changing this env var on Vercel (Production + Preview + Development)
# and redeploying. Empty = nobody can Run Analysis. Wrapping quotes are stripped.
ADMIN_EMAILS=you@example.com

# Optional durable rate limits. If unset, Claude routes use an in-memory
# per-instance limiter (fine for personal use). Do not 503 when missing.
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Optional: override the Vercel deployment URL for local dev
# VITE_API_BASE_URL=http://localhost:3000
